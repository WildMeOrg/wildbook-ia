FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    curl \
    wget \
    unzip \
    git \
    pkg-config \
    libgl1-mesa-glx \
    libglib2.0-0 \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    python3-setuptools \
    python3-wheel \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Symlink Python & Pip
RUN ln -s /usr/bin/python3 /usr/bin/python && ln -s /usr/bin/pip3 /usr/bin/pip

# Install Python packages early
RUN pip install --upgrade pip setuptools wheel scikit-build ninja numpy

# Install opencv-python (includes native libs but NOT OpenCVConfig.cmake)
RUN pip install opencv-python-headless
