FROM wildme/wbia-base:latest

WORKDIR /wbia

COPY requirements.txt .

RUN pip install --force-reinstall -r requirements.txt

# Inject OpenCV flags manually for pyhesaff
ENV CMAKE_PREFIX_PATH=/usr/local/lib/python3.12/dist-packages/opencv_python.libs

# Try to build pyhesaff — fail allowed if fallback needed
RUN pip install pyhesaff fairseq --no-cache-dir || true
